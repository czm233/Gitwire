# Copy to .env.production (chmod 600); never commit filled credentials.
# Use a generated hexadecimal password, not this placeholder.
GITWIRE_DB_PASSWORD=REPLACE_WITH_RANDOM_HEXADECIMAL_PASSWORD
PUBLIC_URL=https://gitwire.example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ENCRYPTION_KEY=
LLM_PROTOCOL=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=16384
LLM_THINKING=
# Optional operator token for PUBLIC API reads only. Users never generate PATs.
GITHUB_TOKEN=
SOURCE_CLONE_TIMEOUT_SECONDS=120
SOURCE_CLONE_MAX_MB=200
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FEEDBACK_SECRET=
MAIL_USER_HOURLY_LIMIT=50
MAIL_GLOBAL_HOURLY_LIMIT=1000
MODEL_DAILY_LIMIT=300
MODEL_REPO_DAILY_LIMIT=50
ANALYSIS_DAILY_LIMIT=20
MAX_SUBSCRIPTIONS=50
REPO_SCAN_MINUTES=60
ISSUE_SCAN_MINUTES=15
