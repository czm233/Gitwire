# Gitwire 配置 —— 复制为 .env 后填写，.env 不进版本库

# 旧单用户 CLI 配置；托管模式不会使用此远端推送
GITWIRE_VAULT=/path/to/gitwire-vault

# 可选的平台公开数据读取 Token；普通用户无需填写，托管模式不使用它推送
GITHUB_TOKEN=

# LLM：双协议，按渠道二选一
# 协议：openai（默认，任意 OpenAI 兼容接口）| anthropic（Anthropic Messages 协议）
LLM_PROTOCOL=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=16384          # anthropic 协议必填上限，openai 协议忽略
LLM_THINKING=                 # 留空默认；disabled = 关思考块（anthropic 协议，批处理更省时）

# ── 渠道示例（取消对应整段注释，改 .env 顶部四行）──
# GLM Coding Plan（智谱 Anthropic 兼容口，套餐 key）：
#   LLM_PROTOCOL=anthropic
#   LLM_BASE_URL=https://open.bigmodel.cn/api/anthropic
#   LLM_MODEL=glm-4.7        # 免费档 glm-4.7-flash
#
# Gemini 中转站（Anthropic 协议反代，如 CLIProxyAPI）：
#   LLM_PROTOCOL=anthropic
#   LLM_BASE_URL=https://your-model-gateway.example
#   LLM_MODEL=gemini-3-flash
#
# DeepSeek / 智谱 paas / one-api 网关等 OpenAI 兼容口：
#   LLM_PROTOCOL=openai
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat

# v1：Bark 推送（iOS，留空 = 警报只进台账不推送）
# 填 Bark 的完整地址，如 https://api.day.app/你的key
BARK_URL=
BARK_GROUP=Gitwire

# v1：Obsidian 模式——给产出 markdown 注入 YAML frontmatter（属性/标签/图谱）
# GITWIRE_VAULT 指向 Obsidian 库里的文件夹时开启
OBSIDIAN_FRONTMATTER=false

# 旧版本配置；托管模式仅支持 GitHub 登录
SECRET_KEY=

# 调度
WATCH_CRON=0 * * * *
DAILY_CRON=0 8 * * *

# 数据目录：SQLite + vault 本地 clone + 监控仓库缓存
DATA_DIR=./data

# 可选：vault 提交身份，"Name <email>"；缺省用本机 git config
GIT_AUTHOR=

# 晨报/changelog 使用的时区
TZ=Asia/Shanghai

# 托管多用户模式（默认开启）
HOSTED_ENABLED=true
PUBLIC_URL=http://127.0.0.1:10241
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 这里的数据库密码必须与 .env.infra 的 GITWIRE_DB_PASSWORD 一致
DATABASE_URL=postgresql+psycopg://gitwire:replace-with-a-local-random-password@127.0.0.1:10243/gitwire
REDIS_URL=redis://127.0.0.1:10244/0
# Fernet 密钥：首次生成后妥善备份，不要在重启时重新生成
ENCRYPTION_KEY=
SESSION_DAYS=30
REPO_SCAN_MINUTES=60
ISSUE_SCAN_MINUTES=15
MAX_SUBSCRIPTIONS=50
ANALYSIS_DAILY_LIMIT=20
MODEL_DAILY_LIMIT=300
MODEL_REPO_DAILY_LIMIT=50
# 首次源码快照：超时/超过缓存上限则退回同一提交的 API 关键文件样本
SOURCE_CLONE_TIMEOUT_SECONDS=120
SOURCE_CLONE_MAX_MB=200
# 本地 Mailpit：所有测试邮件留在本机，不会投递到真实邮箱
SMTP_HOST=127.0.0.1
SMTP_PORT=10245
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM="Gitwire <test@gitwire.local>"

# 可选：邮件供应商回执转接服务的 HMAC 密钥（不是 GitHub Webhook）
MAIL_FEEDBACK_SECRET=
MAIL_USER_HOURLY_LIMIT=50
MAIL_GLOBAL_HOURLY_LIMIT=1000
